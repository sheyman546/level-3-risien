# =============================================================================
# StellarFlow Hub — Environment variables
# Copy this file to `.env` and adjust. Never commit real secrets.
# =============================================================================

# --- Network -----------------------------------------------------------------
# Which Stellar network to talk to: "testnet" | "mainnet" | "local"
STELLARFLOW_NETWORK=testnet

# Soroban RPC endpoint (defaults are picked per network if left empty):
#   testnet -> https://soroban-testnet.stellar.org
#   mainnet -> https://soroban-mainnet.stellar.org
#   local   -> http://localhost:8000
STELLARFLOW_RPC_URL=

# Network passphrase (defaults picked per network):
#   testnet -> Test SDF Network ; September 2015
#   mainnet -> Public Global Stellar Network ; September 2015
#   local   -> Standalone Network ; February 2017
STELLARFLOW_NETWORK_PASSPHRASE=

# Horizon endpoint (used by tooling only, e.g. friendbot funding)
STELLARFLOW_HORIZON_URL=

# --- Deployed contract IDs (C... addresses) ---------------------------------
# Populated by `pnpm deploy:testnet` / `pnpm deploy:local`
STELLARFLOW_PAYMENT_CONTRACT=
STELLARFLOW_ESCROW_CONTRACT=
STELLARFLOW_REGISTRY_CONTRACT=

# --- Signing / deployment ----------------------------------------------------
# Secret key of the deployer / seed account. NEVER commit a real value.
# Used by contracts/scripts (stellar CLI) and scripts/seed.
STELLARFLOW_SECRET_KEY=

# --- Event indexer -----------------------------------------------------------
# Where the web app reaches the event indexer (SSE + REST)
STELLARFLOW_INDEXER_URL=http://localhost:4000
# Port the indexer HTTP server listens on
INDEXER_PORT=4000
# How often the indexer polls the RPC for new events (ms)
INDEXER_POLL_INTERVAL_MS=4000
# How many events to fetch per poll
INDEXER_BATCH_SIZE=100
# How far back (ledgers) to start indexing on a fresh database
INDEXER_START_LEDGER=0

# --- Database (event indexer) ------------------------------------------------
DATABASE_URL=postgres://stellarflow:stellarflow@localhost:5432/stellarflow
