{
  "name": "@stellarflow/event-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indexes StellarFlow contract events from Stellar RPC into Postgres and streams them over SSE",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "@stellarflow/config": "workspace:*",
    "@stellarflow/types": "workspace:*",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
